// Maze Ghost — what the Ghost account may not do, whoever is at the keyboard.
//
// Hibernation writes the whole of memory — the Ghost session's home
// included — to disk. The Ghost account may suspend, not hibernate.
//
// Everything else here would either reach the outside world without going
// through Ghost's Tor-only firewall (a system service does it, as its own
// user), or leave a lasting change on the machine after the session ends:
//
//   ModemManager      SMS, calls, USSD and the modem's location — a cellular
//                     line straight past Tor; active sessions get them
//                     without a password by default
//   NetworkManager    sharing the connection as a hotspot, system-wide
//                     connections, DNS and hostname (Ghost may still add and
//                     use Wi-Fi of its own; those are removed at logout)
//   hostname1         changing the hostname (sent to every DHCP server), and
//                     reading the hardware serial / product UUID, which
//                     identify the machine
//   timedate1/locale1 system clock, time zone and locale outlive the session
//   CUPS helper       adding printers (and their network discovery)
//   PackageKit, Flatpak, fwupd   installs and downloads, as root
//   login1 linger     "keep my services running after I log out": open to
//                     every account without a password by default. For Ghost
//                     it would keep the user manager — and so the in-memory
//                     home — alive past logout, and the clean-up would never
//                     run (audit GH5).
polkit.addRule(function (action, subject) {
    if (subject.user !== "ghost") {
        return polkit.Result.NOT_HANDLED;
    }
    var id = action.id;
    var denied = [
        "org.freedesktop.login1.hibernate",
        "org.freedesktop.login1.hybrid-sleep",
        "org.freedesktop.login1.suspend-then-hibernate",
        "org.freedesktop.login1.set-self-linger",
        "org.freedesktop.ModemManager1.",
        "org.freedesktop.NetworkManager.wifi.share.",
        "org.freedesktop.NetworkManager.settings.modify.system",
        "org.freedesktop.NetworkManager.settings.modify.hostname",
        "org.freedesktop.NetworkManager.settings.modify.global-dns",
        "org.freedesktop.NetworkManager.checkpoint-rollback",
        "org.freedesktop.NetworkManager.reload",
        "org.freedesktop.hostname1.",
        "org.freedesktop.timedate1.",
        "org.freedesktop.locale1.",
        "org.opensuse.cupspkhelper.mechanism.",
        "org.freedesktop.packagekit.",
        "org.freedesktop.Flatpak.",
        "org.freedesktop.fwupd.",
    ];
    for (var i = 0; i < denied.length; i++) {
        if (id.indexOf(denied[i]) === 0) {
            return polkit.Result.NO;
        }
    }
    return polkit.Result.NOT_HANDLED;
});
