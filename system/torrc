## Maze Ghost — the Tor the Ghost session goes through. Generated by the
## package; put bridges and other additions in /etc/maze-ghost/torrc.d/
## (every file there that does not start with a dot is read).
DataDirectory /var/lib/maze-ghost-tor
Log notice syslog
ClientOnly 1
AvoidDiskWrites 1

# The firewall sends the Ghost account's TCP here, its DNS to the DNSPort.
TransPort 127.0.0.1:9140 IsolateClientAddr IsolateDestAddr IsolateDestPort
DNSPort 127.0.0.1:9153
SocksPort 127.0.0.1:9150 IsolateDestAddr IsolateDestPort

# Names resolve to placeholder addresses that Tor maps back, so .onion works
# for every program, not only for browsers that speak SOCKS.
VirtualAddrNetworkIPv4 10.192.0.0/10
AutomapHostsOnResolve 1
AutomapHostsSuffixes .onion,.exit

%include /etc/maze-ghost/torrc.d/
