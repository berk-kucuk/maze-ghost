# Maze Ghost — package install hooks.
#
# The Ghost account is created here rather than with sysusers.d on purpose:
# sysusers gives system accounts (uid < 1000), and SDDM only lists accounts
# from uid 1000 up. It has no password, so it can be chosen at the login
# screen like any other; sshd refuses empty passwords by default.

_info() { echo "  [maze-ghost] $*"; }

_dropin_for() {
    echo "/etc/systemd/system/user@$1.service.d/50-maze-ghost.conf"
}

_ensure_account() {
    if ! id ghost >/dev/null 2>&1; then
        local shell=/bin/bash
        [ -x /bin/zsh ] && shell=/bin/zsh
        useradd --comment "Ghost — nothing is kept, Tor only" --home-dir /home/ghost \
                --no-create-home --shell "$shell" --user-group ghost
        passwd -d ghost >/dev/null
        _info "Created the Ghost account (no password, appears at the login screen)"
    fi
    install -d -o root -g root -m 0700 /home/ghost
    install -d -o root -g root -m 0755 /var/lib/maze-ghost
    install -d -o ghost -g ghost -m 0700 /var/lib/maze-ghost/persistent
    # The session scripts belong to this one account only: a drop-in for its
    # own user manager, so nothing here can ever touch another account's login.
    local uid dropin
    uid="$(id -u ghost)"
    dropin="$(_dropin_for "$uid")"
    install -d -m 0755 "$(dirname "$dropin")"
    cat > "$dropin" <<EOF
# Maze Ghost — generated by the maze-ghost package for the Ghost account.
[Service]
ExecStartPre=+/usr/lib/maze-ghost/ghost-session-start %i
ExecStopPost=+/usr/lib/maze-ghost/ghost-session-stop %i
EOF
}

post_install() {
    _ensure_account
    systemctl daemon-reload
    systemctl enable --now maze-ghost-firewall.service >/dev/null 2>&1
    systemctl enable maze-ghost-cleanup.service >/dev/null 2>&1
    echo
    _info "Ghost is ready. Restart the computer once (logind reads its new"
    _info "settings at boot), then choose \"Ghost\" at the login screen."
    _info "Bridges for networks that block Tor: /etc/maze-ghost/torrc.d/"
    echo
}

post_upgrade() {
    _ensure_account
    systemctl daemon-reload
    systemctl enable maze-ghost-firewall.service maze-ghost-cleanup.service >/dev/null 2>&1
    systemctl restart maze-ghost-firewall.service >/dev/null 2>&1
}

pre_remove() {
    if id ghost >/dev/null 2>&1; then
        loginctl terminate-user ghost 2>/dev/null
        rm -f "$(_dropin_for "$(id -u ghost)")"
        rmdir "$(dirname "$(_dropin_for "$(id -u ghost)")")" 2>/dev/null
    fi
    systemctl disable --now maze-ghost-cleanup.service >/dev/null 2>&1
    systemctl stop maze-ghost-tor.service >/dev/null 2>&1
    # Last: the firewall goes only after the session it guards is gone.
    systemctl disable --now maze-ghost-firewall.service >/dev/null 2>&1
}

post_remove() {
    systemctl daemon-reload
    if id ghost >/dev/null 2>&1; then
        userdel ghost 2>/dev/null
        rmdir /home/ghost 2>/dev/null
    fi
    if [ -n "$(ls -A /var/lib/maze-ghost/persistent 2>/dev/null)" ]; then
        _info "Encrypted capsules from Ghost sessions were kept in"
        _info "/var/lib/maze-ghost/persistent — remove it by hand if you are done."
    else
        rm -rf /var/lib/maze-ghost
    fi
}
